# Required for /api/grade
OPENAI_API_KEY=sk-...
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=...
# Or use the anon key if service role is not available:
SUPABASE_ANON_KEY=

# Supabase (client — same project as server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Or Supabase publishable key:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Credits (Sprint 1 placeholder purchases)
CREDITS_PLACEHOLDER_MODE=true
CREDIT_PACK_STARTER=10
CREDIT_PACK_STANDARD=50
CREDIT_PACK_PRO=100

# Shopify → GemGrade credits (gemcardshow.com webhook)
SHOPIFY_WEBHOOK_SECRET=
# JSON maps: variant_id or SKU string → credit amount
# Live Pro Scan packs grant two credits per purchased scan.
SHOPIFY_CREDIT_VARIANT_MAP={"56437258551462":20,"56437261041830":50,"56591607955622":100,"56594782093478":200}
SHOPIFY_CREDIT_SKU_MAP={}

# Shopify → GemGrade signed auth handoff (New Customer Accounts + App Proxy)
# See docs/shopify-gemgrade-auth-handoff.md
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_HANDOFF_SECRET=
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
# Optional override; omit to use client_credentials with API key + secret
# SHOPIFY_ADMIN_ACCESS_TOKEN=

# Admin tools (/admin/credits)
ADMIN_EMAILS=gemcardshow@gmail.com,akurgin@att.net

# Apple App Review demo account (server-side provisioning only — never commit real values)
# Create with: node --env-file=.env.local scripts/create-apple-reviewer-account.mjs
# Provide the same email/password to Apple in App Store Connect Review Information.
APPLE_REVIEW_EMAIL=
APPLE_REVIEW_PASSWORD=

# Optional overrides
# Production magic-link callback base (local dev can omit — uses browser origin)
NEXT_PUBLIC_SITE_URL=https://app.gemcardshow.com
OPENAI_VISION_MODEL=gpt-4o-mini
