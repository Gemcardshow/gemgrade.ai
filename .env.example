# Required for /api/grade
OPENAI_API_KEY=sk-...
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=...
# Or use the anon key if service role is not available:
SUPABASE_ANON_KEY=

# Supabase (client — same project as server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Credits (Sprint 1 placeholder purchases)
CREDITS_PLACEHOLDER_MODE=true
CREDIT_PACK_STARTER=10
CREDIT_PACK_STANDARD=50
CREDIT_PACK_PRO=100

# Optional overrides
OPENAI_VISION_MODEL=gpt-4o-mini
