# Required for /api/grade
OPENAI_API_KEY=sk-...
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=...
# Or use the anon key if service role is not available:
SUPABASE_ANON_KEY=

# Supabase (client — same project as server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Or Supabase publishable key:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Credits (Sprint 1 placeholder purchases)
CREDITS_PLACEHOLDER_MODE=true
CREDIT_PACK_STARTER=10
CREDIT_PACK_STANDARD=50
CREDIT_PACK_PRO=100

# Shopify → GemGrade credits (gemcardshow.com webhook)
SHOPIFY_WEBHOOK_SECRET=
# JSON maps: variant_id or SKU string → credit amount
SHOPIFY_CREDIT_VARIANT_MAP={"123456789":10,"987654321":50}
SHOPIFY_CREDIT_SKU_MAP={"GG-SCOUT-10":10,"GG-STANDARD-50":50,"GG-PRO-100":100}

# Admin tools (/admin/credits)
ADMIN_EMAILS=gemcardshow@gmail.com,akurgin@att.net

# Optional overrides
# Production magic-link callback base (local dev can omit — uses browser origin)
NEXT_PUBLIC_SITE_URL=https://gemgrade-ai.vercel.app
OPENAI_VISION_MODEL=gpt-4o-mini
